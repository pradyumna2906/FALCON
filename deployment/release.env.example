# Copy outside Git, chmod 600; all REPLACE values must be supplied by the owner.
FALCON_RELEASE_ENV=/absolute/private/release.env
FALCON_TLS_DIR=/absolute/private/tls
FALCON_CLASSIFIER_DIR=/absolute/reviewed/classification
FALCON_REDIS_CONFIG=/absolute/private/redis.conf
FALCON_DB_NAME=falcon
FALCON_DB_USER=falcon
FALCON_DB_PASSWORD=REPLACE
FALCON_AUTH_SIGNING_SECRET=REPLACE
FALCON_AUTH_DELIVERY_ENCRYPTION_KEY=REPLACE
FALCON_AUTH_DELIVERY_ENCRYPTION_KEY_ID=release-v1
FALCON_ASSISTANT_HISTORY_ENCRYPTION_KEYS=["REPLACE"]
FALCON_DELIVERY_PREVIOUS_KEYS={}
FALCON_REDIS_URL=redis://:REPLACE@redis:6379/0
FALCON_PUBLIC_ORIGIN=https://REPLACE
FALCON_SMTP_HOST=REPLACE
FALCON_SMTP_PORT=465
FALCON_SMTP_MODE=ssl
FALCON_SMTP_USERNAME=REPLACE
FALCON_SMTP_PASSWORD=REPLACE
FALCON_SMTP_SENDER=REPLACE
FALCON_ASSISTANT_PROVIDER=openai
FALCON_OPENAI_API_KEY=REPLACE
FALCON_OPENAI_MODEL=REPLACE
FALCON_OPENAI_INPUT_USD_PER_MILLION=0
FALCON_OPENAI_OUTPUT_USD_PER_MILLION=0
FALCON_CLASSIFICATION_ARTIFACT_ROOT=/models/classification
FALCON_DOCS_ENABLED=false
FALCON_DEBUG=false
