# Application
FALCON_ENV=development
FALCON_DEBUG=true
FALCON_DOCS_ENABLED=true
# FALCON_API_HOST is used only by direct host execution.
FALCON_API_HOST=127.0.0.1
FALCON_API_PORT=8000

# Browser access
# JSON array of exact trusted HTTP(S) origins. Wildcards, credentials, paths,
# query strings and fragments are rejected.
FALCON_CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# PostgreSQL development database
# This is a local bootstrap administrator. The database phase will create
# a separate least-privilege application role.
FALCON_DB_HOST=127.0.0.1
FALCON_DB_PORT=5433
FALCON_DB_NAME=falcon
FALCON_DB_USER=falcon_dev
FALCON_DB_PASSWORD=replace_with_a_strong_local_password
FALCON_DB_POOL_SIZE=5
FALCON_DB_MAX_OVERFLOW=5
FALCON_DB_POOL_TIMEOUT_SECONDS=5
FALCON_DB_POOL_RECYCLE_SECONDS=1800
FALCON_DB_CONNECT_TIMEOUT_SECONDS=5
FALCON_DB_READINESS_TIMEOUT_SECONDS=2

# Phase 7 classifier artifacts are verified and loaded lazily on first use.
FALCON_CLASSIFICATION_ARTIFACT_ROOT=ml/artifacts/classification
FALCON_CLASSIFICATION_MODEL_VERSION=classification_2026_1_demo.1

# Authentication
# Replace the signing secret locally and in every deployed environment.
# Generate it with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
FALCON_AUTH_SIGNING_SECRET=replace_with_a_random_secret_of_at_least_32_characters
FALCON_AUTH_ACCESS_TOKEN_ALGORITHM=HS256
FALCON_AUTH_ACCESS_TOKEN_ISSUER=falcon-api
FALCON_AUTH_ACCESS_TOKEN_AUDIENCE=falcon-web
FALCON_AUTH_ACCESS_TOKEN_LIFETIME_MINUTES=15
FALCON_AUTH_REFRESH_TOKEN_LIFETIME_DAYS=7
FALCON_AUTH_EMAIL_VERIFICATION_LIFETIME_MINUTES=30
FALCON_AUTH_PASSWORD_RESET_LIFETIME_MINUTES=15
FALCON_AUTH_OPAQUE_TOKEN_BYTES=32
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FALCON_AUTH_DELIVERY_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
FALCON_AUTH_DELIVERY_ENCRYPTION_KEY_ID=local-development-v1
FALCON_AUTH_PASSWORD_MIN_LENGTH=12
FALCON_AUTH_PASSWORD_MAX_LENGTH=128

# Grounded assistant
# JSON key ring: first key encrypts new history, up to two older keys decrypt
# during rotation. Generate each key with Fernet.generate_key().
FALCON_ASSISTANT_HISTORY_ENCRYPTION_KEYS=["ZmFsY29uLWFzc2lzdGFudC1oaXN0b3J5LWtleS12MSE="]
# Process-local safeguards. Phase 13 owns distributed throttling.
FALCON_ASSISTANT_REQUESTS_PER_MINUTE=20
FALCON_ASSISTANT_MAX_CONCURRENT_REQUESTS=1
FALCON_ASSISTANT_REQUEST_TIMEOUT_SECONDS=30
