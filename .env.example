# Application
FALCON_ENV=development
FALCON_DEBUG=true
FALCON_DOCS_ENABLED=true
# FALCON_API_HOST is used only by direct host execution.
FALCON_API_HOST=127.0.0.1
FALCON_API_PORT=8000

# Browser access
# JSON array of exact trusted HTTP(S) origins. Wildcards, credentials, paths,
# query strings and fragments are rejected.
FALCON_CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# PostgreSQL development database
# This is a local bootstrap administrator. The database phase will create
# a separate least-privilege application role.
FALCON_DB_HOST=127.0.0.1
FALCON_DB_PORT=5433
FALCON_DB_NAME=falcon
FALCON_DB_USER=falcon_dev
FALCON_DB_PASSWORD=replace_with_a_strong_local_password
FALCON_DB_POOL_SIZE=5
FALCON_DB_MAX_OVERFLOW=5
FALCON_DB_POOL_TIMEOUT_SECONDS=5
FALCON_DB_POOL_RECYCLE_SECONDS=1800
FALCON_DB_CONNECT_TIMEOUT_SECONDS=5
FALCON_DB_READINESS_TIMEOUT_SECONDS=2

# Authentication
FALCON_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters
FALCON_ACCESS_TOKEN_EXPIRE_MINUTES=15
FALCON_REFRESH_TOKEN_EXPIRE_DAYS=7
