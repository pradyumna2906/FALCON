# Application
FALCON_ENV=development
FALCON_DEBUG=true
FALCON_API_HOST=127.0.0.1
FALCON_API_PORT=8000
FALCON_FRONTEND_URL=http://localhost:5173

# PostgreSQL
FALCON_DB_HOST=localhost
FALCON_DB_PORT=5432
FALCON_DB_NAME=falcon
FALCON_DB_USER=falcon_app
FALCON_DB_PASSWORD=change_this_locally

# Authentication
FALCON_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters
FALCON_ACCESS_TOKEN_EXPIRE_MINUTES=15
FALCON_REFRESH_TOKEN_EXPIRE_DAYS=7
